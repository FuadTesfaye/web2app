{
  "name": "web2app",
  "version": "0.1.0",
  "description": "Convert Next.js, React, Vite, Vue, Svelte, Python, and live web URLs into standalone native Android, Windows, Debian, and Arch apps with zero runtime overhead.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "web2app": "./bin/web2app.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FuadTesfaye/web2app.git"
  },
  "homepage": "https://github.com/FuadTesfaye/web2app#readme",
  "bugs": {
    "url": "https://github.com/FuadTesfaye/web2app/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "web2app",
    "nextjs-to-apk",
    "nextjs",
    "react",
    "vite",
    "pwa",
    "android",
    "webview2",
    "windows",
    "debian",
    "arch-linux",
    "mobile",
    "desktop",
    "cli",
    "ai-skill",
    "native-compiler"
  ],
  "author": "Fuad Tesfaye",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "nanospinner": "^1.2.2",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
